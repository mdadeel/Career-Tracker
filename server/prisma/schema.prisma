generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  Saved
  Applied
  Assessment
  Interview
  Rejected
  Offer
}

enum ApplicationSource {
  LinkedIn
  Bdjobs
  Indeed
  Wellfound
  Facebook
  Referral
  Other
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  resumeText   String?
  skills       String[]
  aiProvider   String        @default("system_default")
  aiApiKey     String?
  aiBaseUrl    String?
  aiModel      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("users")
}

model Application {
  id              String             @id @default(uuid())
  companyName     String
  jobTitle        String
  jobUrl          String?
  source          ApplicationSource
  applicationDate DateTime
  status          ApplicationStatus  @default(Saved)
  notes           String?
  jobDescription  String?
  resumeLink      String?
  resumeText      String?
  interviewDate   DateTime?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String             @default("USD")
  location        String?
  employmentType  String?
  remoteStatus    String?
  companyLogo     String?
  aiMatchScore    Int?
  aiAnalysis      Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("applications")
}
