# Database
DATABASE_URL="postgresql://user:password@localhost:5432/careertrack?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="24h"

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Logging (optional — defaults to "info")
LOG_LEVEL="info"

# Prisma connection pool (optional — injected into DATABASE_URL)
# PRISMA_POOL_SIZE="10"

# Rate limiting (optional — defaults to 15 in production)
# AUTH_RATE_LIMIT_MAX="15"

# Error monitoring (optional — requires a Sentry DSN)
# SENTRY_DSN="https://your-dsn@o123456.ingest.sentry.io/1234567"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
